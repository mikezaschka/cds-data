{
  "name": "cds-data-pipeline",
  "version": "0.2.0",
  "description": "A CAP application-layer plugin for declarative, traceable, scheduled data pipelines between CAP services. Each pipeline is a linear READ -> MAP -> WRITE job between exactly one source and one target, with built-in tracker, retry, concurrency guard, management OData API, and event hooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezaschka/cds-data.git",
    "directory": "packages/cds-data-pipeline"
  },
  "keywords": [
    "sap",
    "cap",
    "cds",
    "pipeline",
    "replication",
    "data-integration"
  ],
  "author": "Mike Zaschka <opensource@mikezaschka.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikezaschka/cds-data/issues"
  },
  "homepage": "https://github.com/mikezaschka/cds-data#readme",
  "main": "cds-plugin.js",
  "files": [
    "srv/**",
    "db/**",
    "index/**",
    "index.cds",
    "lib/**",
    "app/pipeline-console/**",
    "!app/pipeline-console/test-resources",
    "!app/pipeline-console/test-resources/**",
    "app/pipeline-console-src/**",
    "cds-plugin.js",
    "README.md",
    "AGENTS.md",
    "skills/**"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:integration:postgres": "vitest run --config vitest.postgres.config.mjs",
    "test:watch": "vitest",
    "sync:pipeline-console-webapp": "rm -rf app/webapp && cp -R app/pipeline-console-src/webapp app/webapp",
    "build:pipeline-console": "npm run sync:pipeline-console-webapp && cd app && ui5 build self-contained --clean-dest --all --config pipeline-console.build.ui5.yaml --dest pipeline-console && rm -rf pipeline-console/test-resources",
    "dev:console-backend": "bash examples/_dev/pipeline-console/start.sh",
    "dev:pipeline-console": "cd app && ui5 serve --config pipeline-console.dev.ui5.yaml --port 8090 -o index.html",
    "start:pipeline-console": "npm run dev:pipeline-console",
    "prepublishOnly": "npm run build:pipeline-console",
    "release": "release-it"
  },
  "cds": {
    "folders": {
      "db": "db",
      "srv": "srv"
    },
    "requires": {
      "kinds": {
        "datapipeline": {
          "impl": "cds-data-pipeline"
        },
        "DataPipelineService": {
          "impl": "cds-data-pipeline"
        }
      }
    }
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/postgres": "^2.3.0",
    "@cap-js/sqlite": "^3",
    "@sapui5/types": "^1.120.0",
    "@sap/cds-dk": "^9",
    "@ui5/cli": "^4.0.0",
    "typescript": "^5.0.0",
    "ui5-middleware-cap": "^3.3.0",
    "ui5-tooling-transpile": "^3.3.0",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
