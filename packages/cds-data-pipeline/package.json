{
  "name": "cds-data-pipeline",
  "version": "0.1.0",
  "description": "A CAP application-layer plugin for declarative, traceable, scheduled data pipelines between CAP services. Each pipeline is a linear READ -> MAP -> WRITE job between exactly one source and one target, with built-in tracker, retry, concurrency guard, management OData API, and event hooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezaschka/cds-data-monorepo.git",
    "directory": "packages/cds-data-pipeline"
  },
  "keywords": [
    "sap",
    "cap",
    "cds",
    "pipeline",
    "replication",
    "data-integration"
  ],
  "author": "Mike Zaschka <opensource@mikezaschka.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikezaschka/cds-data-monorepo/issues"
  },
  "homepage": "https://github.com/mikezaschka/cds-data-monorepo#readme",
  "main": "cds-plugin.js",
  "files": [
    "srv/**",
    "db/**",
    "lib/**",
    "scripts/**",
    "app/pipeline-console/**",
    "cds-plugin.js",
    "README.md",
    "AGENTS.md",
    "skills/**"
  ],
  "scripts": {
    "test": "jest --config jest.config.js --runInBand --forceExit",
    "test:unit": "jest --config jest.config.js --runInBand --forceExit --testPathPattern=test/unit",
    "test:integration": "jest --config jest.config.js --runInBand --forceExit --testPathPattern=test/integration"
  },
  "cds": {
    "folders": {
      "db": "db",
      "srv": "srv"
    },
    "requires": {
      "DataPipelineService": {
        "impl": "cds-data-pipeline/srv/DataPipelineService.js"
      }
    }
  },
  "peerDependencies": {
    "@sap/cds": ">=8"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/sqlite": "^2",
    "@jest/globals": "^29.7.0",
    "chai": "^4.5.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
