{
    "name": "cds-data-pipeline-example-07-event-driven-runs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "cds-serve --port 4107"
    },
    "dependencies": {
        "@sap/cds": "^9.2",
        "express": "^4",
        "cds-data-pipeline": "file:../.."
    },
    "devDependencies": {
        "@cap-js/sqlite": "^2"
    },
    "cds": {
        "requires": {
            "datapipeline": {
                "impl": "cds-data-pipeline",
                "management": {
                    "reuse": {
                        "api": true,
                        "console": true
                    }
                }
            },
            "messaging": {
                "[development]": {
                    "kind": "file-based-messaging"
                }
            },
            "db": {
                "kind": "sqlite",
                "credentials": {
                    "url": ":memory:"
                }
            },
            "LogisticsService": {
                "kind": "odata",
                "model": "srv/external/LogisticsService",
                "credentials": {
                    "url": "http://localhost:4455/odata/v4/logistics"
                }
            }
        }
    }
}
