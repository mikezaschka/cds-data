{
    "name": "cds-data-pipeline-dev-pipeline-console",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "cds-serve --port 4100"
    },
    "dependencies": {
        "@sap/cds": "^9.2",
        "cds-data-pipeline": "file:../../..",
        "express": "^4"
    },
    "devDependencies": {
        "@cap-js/sqlite": "^2"
    },
    "cds": {
        "requires": {
            "data-pipeline": {
                "impl": "cds-data-pipeline",
                "management": {
                    "reuse": {
                        "api": true,
                        "console": false
                    }
                }
            },
            "db": {
                "kind": "sqlite",
                "credentials": {
                    "url": ":memory:"
                }
            },
            "ArchiveDb": {
                "kind": "sqlite",
                "schema_evolution": "auto",
                "credentials": {
                    "url": "archive.sqlite"
                }
            },
            "LogisticsService": {
                "kind": "odata",
                "model": "srv/external/LogisticsService",
                "credentials": {
                    "url": "http://localhost:4455/odata/v4/logistics"
                }
            },
            "FXService": {
                "kind": "rest",
                "credentials": {
                    "url": "http://localhost:4456"
                }
            }
        }
    }
}
