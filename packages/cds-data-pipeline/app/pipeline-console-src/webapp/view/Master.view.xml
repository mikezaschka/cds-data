<mvc:View controllerName="pipeline.monitor.fcl.controller.Master"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:graph="sap.suite.ui.commons.networkgraph">
    <f:DynamicPage id="masterPage" class="fclAppMaster sapUiNoContentPadding" showNavButton="false" stickySubheaderProvider="masterTabBar">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>masterPageTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <IconTabBar id="masterTabBar" expandable="false" headerMode="Inline" class="sapUiResponsiveContentPadding"
                 select="onMasterTabSelect">
                <items>
                    <IconTabFilter text="{i18n>masterTabPipelines}" key="pipelines">
                        <Table id="pipelineTable" class="fclPipelinesTable" fixedLayout="true" growing="true" growingThreshold="20"
                            width="100%" mode="SingleSelectMaster" selectionChange="onSelectionChange"
                            noDataText="{i18n>noPipelines}" updateFinished="onTableUpdateFinished"
                            items="{
                                path: '/Pipelines',
                                parameters: {
                                    $select: 'name,description,status,mode,schedule,enabled,lastSync,errorCount'
                                },
                                sorter: { path: 'name' },
                                templateShareable: false
                            }">
                            <headerToolbar>
                                <Toolbar class="fclActionToolbar">
                                    <SearchField id="searchField" width="100%" placeholder="{i18n>searchPlaceholder}" search="onSearch" />
                                    <ToolbarSpacer />
                                    <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>actionRefresh}" press="onRefresh" />
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column width="12rem"><Text text="{i18n>colName}"/></Column>
                                <Column width="6rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
                                    <Text text="{i18n>colStatus}"/>
                                </Column>
                                <Column width="4.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
                                    <Text text="{i18n>colMode}"/>
                                </Column>
                                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
                                    <Text text="{i18n>colEnabled}"/>
                                </Column>
                                <Column width="10rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Block">
                                    <Text text="{i18n>colLastRun}"/>
                                </Column>
                                <Column width="4rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Block">
                                    <Text text="{i18n>colErrors}"/>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Active"
                                    highlight="{ parts: [{path:'status'},{path:'schedule'},{path:'enabled', targetType:'any'}], formatter: '.rowHighlight' }">
                                    <cells>
                                        <ObjectIdentifier title="{name}" text="{description}" class="fclNameCell"/>
                                        <HBox alignItems="Center">
                                            <core:Icon
                                                src="sap-icon://refresh"
                                                visible="{= ${ path: 'status', targetType: 'any' } === 'running' }"
                                                size="1rem"
                                                class="fclRunningIcon sapUiTinyMarginEnd" />
                                            <Text
                                                text="{ path: 'status', formatter: '.formatStatusLabel' }"
                                                tooltip="{ path: 'status', formatter: '.statusTooltip' }" />
                                        </HBox>
                                        <Text text="{mode}" />
                                        <Text text="{ parts: [{path:'schedule'},{path:'enabled', targetType:'any'}], formatter: '.formatScheduleCellLabel' }" />
                                        <Text text="{ path: 'lastSync', targetType: 'any', formatter: '.formatLastRun' }" />
                                        <Text text="{ path: 'errorCount', formatter: '.formatCount' }" textAlign="End" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>masterTabOverview}" key="overview">
                        <VBox class="fclTabPanel" width="100%" height="800px">
                            <graph:Graph id="landscapeGraph" orientation="LeftRight" enableWheelZoom="true"
                                visible="{master>/landscapeReady}" class="fclLandscapeGraph" />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
</mvc:View>
