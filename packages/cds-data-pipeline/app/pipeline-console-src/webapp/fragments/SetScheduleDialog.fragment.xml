<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="scheduleDialog"
        title="{i18n>actionSetSchedule}"
        resizable="false"
        contentWidth="22rem"
        class="fclActionDialog"
        type="Message">
        <content>
            <VBox class="fclActionDialogForm">
                <MessageStrip
                    visible="{= !${detail>/configView/meta/scheduleLiveChangeSupported} }"
                    text="{i18n>scheduleLiveChangeUnsupported}"
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />
                <Label text="{i18n>fdScheduleKind}" class="fclDialogLabel" />
                <SegmentedButton id="scheduleKind" selectedKey="interval" selectionChange="onScheduleKindChange">
                    <items>
                        <SegmentedButtonItem key="interval" text="{i18n>scheduleKindInterval}" />
                        <SegmentedButtonItem key="cron" text="{i18n>scheduleKindCron}" />
                    </items>
                </SegmentedButton>
                <Label text="{i18n>fdEveryMs}" id="scheduleEveryLabel" class="fclDialogLabel sapUiSmallMarginTop" />
                <Input
                    id="scheduleEvery"
                    type="Number"
                    class="fclActionInput" />
                <Label text="{i18n>fdCron}" id="scheduleCronLabel" visible="false" class="fclDialogLabel sapUiSmallMarginTop" />
                <Input
                    id="scheduleCron"
                    visible="false"
                    placeholder="0 2 * * *"
                    class="fclActionInput" />
                <Label text="{i18n>fdScheduleEngine}" class="fclDialogLabel sapUiSmallMarginTop" />
                <Select id="scheduleEngine" class="fclActionInput" width="100%">
                    <core:Item key="spawn" text="spawn" />
                    <core:Item key="queued" text="queued" />
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="scheduleConfirmBtn"
                type="Emphasized"
                text="{i18n>ok}"
                press="onSetScheduleConfirm"
                enabled="{detail>/configView/meta/scheduleLiveChangeSupported}" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onSetScheduleCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
