<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="advancedFilterDialog" title="{i18n>filterDialogTitle}" contentWidth="28rem"
        class="fclFilterDialog" resizable="true">
        <content>
            <VBox items="{filters>/rows}" class="sapUiSmallMargin">
                <items>
                    <HBox alignItems="Center" class="fclFilterRow sapUiTinyMarginBottom">
                        <Input value="{filters>field}" placeholder="{i18n>filterField}" width="8rem" />
                        <Select selectedKey="{filters>op}" width="6rem" class="sapUiTinyMarginBegin">
                            <core:Item key="eq" text="=" />
                            <core:Item key="ne" text="≠" />
                            <core:Item key="gt" text="&gt;" />
                            <core:Item key="ge" text="≥" />
                            <core:Item key="lt" text="&lt;" />
                            <core:Item key="le" text="≤" />
                            <core:Item key="contains" text="contains" />
                        </Select>
                        <Input value="{filters>value}" placeholder="{i18n>filterValue}" width="10rem"
                            class="sapUiTinyMarginBegin" />
                    </HBox>
                </items>
            </VBox>
            <Button text="{i18n>filterAdd}" icon="sap-icon://add" type="Transparent"
                press="onAddFilterRow" class="sapUiSmallMarginBegin" />
        </content>
        <beginButton>
            <Button text="{i18n>actionApply}" type="Emphasized" press="onFilterApply" />
        </beginButton>
        <endButton>
            <Button text="{i18n>actionReset}" press="onFilterReset" />
            <Button text="{i18n>cancel}" press="onFilterCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
