{
  "name": "cds-data-federation",
  "version": "0.1.0",
  "description": "A data federation plugin for SAP CAP applications supporting delegation, caching, and replication strategies via declarative CDS annotations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezaschka/cds-data.git",
    "directory": "packages/cds-data-federation"
  },
  "keywords": [
    "sap",
    "cap",
    "cds",
    "federation",
    "delegation",
    "remote-services"
  ],
  "author": "Mike Zaschka <opensource@mikezaschka.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikezaschka/cds-data/issues"
  },
  "homepage": "https://github.com/mikezaschka/cds-data#readme",
  "main": "cds-plugin.js",
  "files": [
    "srv/**",
    "index.cds",
    "cds-plugin.js",
    "README.md",
    "AGENTS.md",
    "skills/**"
  ],
  "peerDependencies": {
    "@cap-js/sqlite": ">=2",
    "@sap/cds": ">=9",
    "cds-caching": ">=1",
    "cds-data-pipeline": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@cap-js/sqlite": {
      "optional": true
    },
    "cds-caching": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "example:mcp": "bash examples/mcp-federation/start.sh",
    "release": "release-it"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "cds-caching": "^1.3.0",
    "cds-data-pipeline": "*",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
