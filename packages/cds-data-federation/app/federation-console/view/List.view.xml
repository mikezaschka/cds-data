<mvc:View
    controllerName="federation.console.controller.List"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:graph="sap.suite.ui.commons.networkgraph">
    <f:DynamicPage id="listPage" headerExpanded="true" showFooter="false"
                   class="sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>appTitle}" />
                </f:heading>
                <f:actions>
                    <!-- Only offered when metrics are configured: a runtime switch can
                         pause collection, not instrument the handlers. -->
                    <Label text="{i18n>metricsLabel}" visible="{ui>/metricsEnabled}" labelFor="metricsSwitch" />
                    <Switch id="metricsSwitch" state="{ui>/metricsCollecting}" change=".onToggleMetrics"
                            visible="{ui>/metricsEnabled}" tooltip="{i18n>metricsTooltip}" />
                    <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <IconTabBar id="tabs" expanded="true" selectedKey="{ui>/selectedTab}" select=".onTabSelect"
                        applyContentPadding="false" stretchContentHeight="false"
                        headerBackgroundDesign="Transparent" backgroundDesign="Transparent"
                        class="fedTabs">
                <items>
                    <IconTabFilter key="entities" text="{i18n>tabEntities}" icon="sap-icon://tree">
                        <!-- contextualWidth="Auto": column visibility follows the table's
                             own width, not the screen's. In the begin column of a
                             two-column layout the screen is wide but the table is narrow,
                             so screen-based breakpoints popped every column in and made
                             rows 47–89px tall. Now the narrow list is entity + strategy,
                             and the wide one shows everything. -->
                        <Table id="entityTable" items="{/FederatedEntities}" mode="SingleSelectMaster"
                               selectionChange=".onSelectionChange" growing="true" growingThreshold="50"
                               contextualWidth="Auto" class="fedCard">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <SearchField search=".onSearch" placeholder="{i18n>searchPlaceholder}">
                                        <layoutData>
                                            <OverflowToolbarLayoutData shrinkable="true" minWidth="10rem" maxWidth="22rem" />
                                        </layoutData>
                                    </SearchField>
                                    <ToolbarSpacer />
                                    <SegmentedButton selectedKey="{ui>/strategyFilter}" selectionChange=".onFilterStrategy">
                                        <items>
                                            <SegmentedButtonItem key="all" text="{i18n>filterAll}" />
                                            <SegmentedButtonItem key="delegate" text="{i18n>filterDelegate}" />
                                            <SegmentedButtonItem key="replicate" text="{i18n>filterReplicate}" />
                                        </items>
                                    </SegmentedButton>
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="{i18n>colEntity}" /></Column>
                                <!-- Two constraints meet here. Too wide and the entity name loses
                                     out in the narrow begin column: 9rem took 144px of 289 and cut
                                     CachedFlights, HotelBookings and Organizations. Too narrow and
                                     "response cache" wraps: 7rem split it over two lines. -->
                                <Column width="8rem"><Text text="{i18n>colStrategy}" /></Column>
                                <Column minScreenWidth="44rem" demandPopin="false"><Text text="{i18n>colSource}" /></Column>
                                <Column minScreenWidth="56rem" demandPopin="false" width="11rem"><Text text="{i18n>colTraits}" /></Column>
                                <Column minScreenWidth="68rem" demandPopin="false"><Text text="{i18n>colBackedBy}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation">
                                    <cells>
                                        <!-- One line each, ellipsised, full text on hover: a
                                             break-anywhere wrap split FQNs mid-word. -->
                                        <VBox renderType="Bare">
                                            <Text text="{name}" wrapping="false" tooltip="{name}" class="sapMTextBold" />
                                            <Text text="{entity}" wrapping="false" tooltip="{entity}" class="fedSubtle" />
                                        </VBox>
                                        <VBox renderType="Bare">
                                            <ObjectStatus text="{strategy}" state="{= ${strategy} === 'replicate' ? 'Success' : 'Information' }" />
                                            <ObjectStatus text="{= ${path: 'cacheStrategy', targetType: 'any'} ? ${path: 'cacheStrategy', targetType: 'any'} + ' cache' : '' }"
                                                          visible="{= !!${path: 'cacheStrategy', targetType: 'any'} }" state="Warning" />
                                        </VBox>
                                        <VBox renderType="Bare">
                                            <Text text="{sourceEntity}" wrapping="false" />
                                            <Text text="{sourceService}" wrapping="false" tooltip="{sourceService}" class="fedSubtle" />
                                        </VBox>
                                        <HBox wrap="Wrap" class="fedTraits">
                                            <ObjectStatus text="{i18n>traitWritable}" state="Warning" visible="{writable}" />
                                            <ObjectStatus text="{i18n>traitScoped}" state="Information" visible="{scoped}" />
                                            <ObjectStatus text="{i18n>traitReadOnly}" state="None" visible="{= !${writable} }" />
                                        </HBox>
                                        <Text text="{= ${pipeline} || '–' }" wrapping="false" tooltip="{pipeline}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                    <IconTabFilter key="overview" text="{i18n>tabOverview}" icon="sap-icon://org-chart">
                        <MessageStrip text="{i18n>graphEmpty}" type="Information" showIcon="true"
                                      visible="{= !${ui>/landscapeReady} }" class="sapUiSmallMarginBottom" />
                        <!-- The graph needs a parent with an explicit pixel height: given
                             only a CSS class it renders its toolbar over a 10px canvas. -->
                        <VBox width="100%" height="780px" class="fedCard">
                            <graph:Graph id="landscapeGraph" orientation="LeftRight" enableWheelZoom="true"
                                         visible="{ui>/landscapeReady}" />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
</mvc:View>
