<mvc:View
    controllerName="federation.console.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">
    <!-- DynamicPage, like the Pipeline Console's detail: actions live in the
         title bar instead of a free-standing toolbar between header and body. -->
    <f:DynamicPage id="detailPage" busy="{detail>/busy}" headerExpanded="true"
                   showFooter="false" class="sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{detail>/name}" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <Label text="{detail>/entity}" wrapping="true" />
                </f:expandedContent>
                <f:snappedContent>
                    <Label text="{detail>/entity}" />
                </f:snappedContent>
                <!-- Only the actions this entity's strategy supports. -->
                <f:actions>
                    <Button text="{i18n>actionRefreshReplica}" type="Emphasized" press=".onRefreshReplica"
                            visible="{= ${path: 'detail>/strategy', targetType: 'any'} === 'replicate' }" />
                    <Button text="{i18n>actionRefreshSnapshot}" type="Emphasized" press=".onRefreshEntityCache"
                            visible="{= ${path: 'detail>/cacheStrategy', targetType: 'any'} === 'entity' }" />
                    <Button text="{i18n>actionInvalidate}" type="Emphasized" press=".onInvalidate"
                            visible="{= ${path: 'detail>/cacheStrategy', targetType: 'any'} === 'response' }" />
                </f:actions>
                <f:navigationActions>
                    <Button icon="sap-icon://decline" type="Transparent" press=".onNavBack"
                            tooltip="{i18n>close}" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <HBox wrap="Wrap" class="fedHeaderFacts">
                    <ObjectStatus title="{i18n>statusStrategy}" text="{detail>/strategy}"
                                  state="{= ${path: 'detail>/strategy', targetType: 'any'} === 'replicate' ? 'Success' : 'Information' }" />
                    <ObjectStatus title="{i18n>statusCache}"
                                  text="{= ${path: 'detail>/cacheStrategy', targetType: 'any'} || ${i18n>none} }"
                                  state="{= ${path: 'detail>/cacheStrategy', targetType: 'any'} ? 'Warning' : 'None' }" />
                    <ObjectStatus title="{i18n>statusWrites}"
                                  text="{= ${path: 'detail>/writable', targetType: 'any'} ? ${detail>/writeVerbs} : ${i18n>traitReadOnly} }"
                                  state="{= ${path: 'detail>/writable', targetType: 'any'} ? 'Warning' : 'None' }" />
                    <ObjectStatus title="{i18n>statusSource}" text="{detail>/sourceService}" />
                </HBox>
                <Text text="{i18n>noActions}" visible="{detail>/noActions}" class="sapUiTinyMarginTop" />
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <!-- One flex column with a single gap rule, so every section is spaced
                 the same instead of each panel carrying its own margin. -->
            <VBox renderType="Bare" class="fedSections">

                <Panel headerText="{i18n>sectionRuntime}" expandable="true" expanded="true"
                       backgroundDesign="Solid" class="fedCard">
                    <!-- Degradation is a state, not an error: say which flag is off. -->
                    <VBox renderType="Bare" class="fedStack">
                        <MessageStrip text="{detail>/pipelineDetailUnavailable}" type="Information" showIcon="true"
                                      visible="{= !!${path: 'detail>/pipelineDetailUnavailable', targetType: 'any'} }" />
                        <MessageStrip text="{detail>/cacheDetailUnavailable}" type="Information" showIcon="true"
                                      visible="{= !!${path: 'detail>/cacheDetailUnavailable', targetType: 'any'} }" />
                        <MessageStrip text="{i18n>metricsOff}" type="Information" showIcon="true"
                                      visible="{detail>/metricsOff}" />
                        <MessageStrip text="{i18n>metricsIdle}" type="Information" showIcon="true"
                                      visible="{detail>/metricsIdle}" />

                        <HBox wrap="Wrap" visible="{detail>/hasMetrics}" class="fedTiles">
                            <GenericTile header="{i18n>tileRequests}" frameType="OneByHalf">
                                <TileContent><NumericContent value="{detail>/metrics/requests}" withMargin="false" /></TileContent>
                            </GenericTile>
                            <GenericTile header="{i18n>tileErrors}" frameType="OneByHalf">
                                <TileContent><NumericContent value="{detail>/metrics/errors}" withMargin="false"
                                             valueColor="{= ${path: 'detail>/metrics/errors', targetType: 'any'} > 0 ? 'Error' : 'Good' }" /></TileContent>
                            </GenericTile>
                            <GenericTile header="{i18n>tileAvgLatency}" frameType="OneByHalf">
                                <TileContent><NumericContent value="{detail>/metrics/avgLatency}" scale="ms" withMargin="false" /></TileContent>
                            </GenericTile>
                            <GenericTile header="{i18n>tileWrites}" frameType="OneByHalf" visible="{detail>/writable}">
                                <TileContent><NumericContent value="{detail>/metrics/writes}" withMargin="false" /></TileContent>
                            </GenericTile>
                        </HBox>

                        <HBox class="fedLinks" visible="{= !!${path: 'detail>/pipelineDetail', targetType: 'any'} || !!${path: 'detail>/cacheDetail', targetType: 'any'} }">
                            <Link text="{i18n>linkPipeline}" href="{detail>/pipelineDetail}" target="_blank"
                                  visible="{= !!${path: 'detail>/pipelineDetail', targetType: 'any'} }" />
                            <Link text="{i18n>linkCache}" href="{detail>/cacheDetail}" target="_blank"
                                  visible="{= !!${path: 'detail>/cacheDetail', targetType: 'any'} }" />
                        </HBox>
                    </VBox>
                </Panel>

                <Panel headerText="{i18n>sectionConfig}" expandable="true" expanded="true"
                       backgroundDesign="Solid" class="fedCard">
                    <form:SimpleForm layout="ColumnLayout" editable="false"
                                     columnsM="1" columnsL="1" columnsXL="2" labelSpanL="3">
                        <Label text="{i18n>fieldSourceService}" />
                        <Text text="{detail>/sourceService}" />
                        <Label text="{i18n>fieldSourceEntity}" />
                        <Text text="{detail>/sourceEntity}" />
                        <Label text="{i18n>fieldService}" />
                        <Text text="{detail>/service}" />
                        <Label text="{i18n>fieldPipeline}" />
                        <Text text="{= ${detail>/pipeline} || '–' }" />
                        <Label text="{i18n>fieldProjection}" />
                        <Text text="{detail>/projectionLabel}" />
                        <Label text="{i18n>fieldScope}" />
                        <Text text="{= ${path: 'detail>/scoped', targetType: 'any'} ? ${i18n>scopeYes} : ${i18n>scopeNo} }" />
                        <Label text="{i18n>fieldCacheTag}" />
                        <Text text="{= ${detail>/cacheTag} || '–' }" class="fedCode" />
                    </form:SimpleForm>
                </Panel>

                <Panel headerText="{i18n>sectionRenames}" expandable="true" expanded="true"
                       backgroundDesign="Solid" class="fedCard"
                       visible="{= ${path: 'detail>/renames', targetType: 'any'}.length > 0 }">
                    <Table items="{detail>/renames}">
                        <columns>
                            <Column><Text text="{i18n>colLocal}" /></Column>
                            <Column><Text text="{i18n>colRemote}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{detail>local}" class="fedCode" />
                                    <Text text="{detail>remote}" class="fedCode" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
