{
  "name": "federation-example-07-hcql",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable example: CAP-to-CAP delegate over an @hcql provider — flattened associations",
  "scripts": {
    "start": "cds-serve --port 4137"
  },
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": ">=10",
    "cds-data-federation": "*",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=3"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": ":memory:" }
      },
      "ProviderService": {
        "kind": "odata",
        "model": "srv/external/ProviderService",
        "credentials": { "url": "http://localhost:4147/odata/v4/provider" }
      }
    }
  }
}
