{
  "definitions": {
    "ProviderService": {
      "kind": "service"
    },
    "ProviderService.Customers": {
      "kind": "entity",
      "projection": {
        "from": {
          "ref": [
            "provider.Customers"
          ]
        }
      },
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.String",
          "length": 10
        },
        "name": {
          "type": "cds.String",
          "length": 100
        },
        "city": {
          "type": "cds.String",
          "length": 50
        },
        "country": {
          "type": "cds.String",
          "length": 3
        },
        "email": {
          "type": "cds.String",
          "length": 100
        },
        "blocked": {
          "type": "cds.Boolean",
          "default": {
            "val": false
          }
        },
        "modifiedAt": {
          "type": "cds.Timestamp"
        },
        "orders": {
          "type": "cds.Association",
          "cardinality": {
            "max": "*"
          },
          "target": "ProviderService.Orders",
          "on": [
            {
              "ref": [
                "orders",
                "customer"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        }
      },
      "@cds.redirection.target": true
    },
