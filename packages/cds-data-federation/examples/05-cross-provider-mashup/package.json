{
  "name": "federation-example-05-cross-provider-mashup",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable example: one local entity joined to two different remote providers via cross-provider $expand",
  "scripts": {
    "start": "cds-serve --port 4135"
  },
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": ">=9",
    "cds-data-federation": "*",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": ":memory:" }
      },
      "ProviderService": {
        "kind": "odata",
        "model": "srv/external/ProviderService",
        "credentials": { "url": "http://localhost:4145/odata/v4/provider" }
      },
      "InventoryService": {
        "kind": "odata",
        "model": "srv/external/InventoryService",
        "credentials": { "url": "http://localhost:4155/odata/v4/inventory" }
      }
    }
  }
}
