{
  "name": "federation-example-02-replicate",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable example: @federation.replicate — scheduled sync into local SQLite + delta + local SQL",
  "scripts": {
    "start": "cds-serve --port 4132"
  },
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": ">=9",
    "cds-data-federation": "*",
    "cds-data-pipeline": "*",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": ":memory:" }
      },
      "datapipeline": {
        "impl": "cds-data-pipeline",
        "management": { "reuse": { "api": true, "console": true } }
      },
      "ProviderService": {
        "kind": "odata",
        "model": "srv/external/ProviderService",
        "credentials": { "url": "http://localhost:4142/odata/v4/provider" }
      }
    }
  }
}
