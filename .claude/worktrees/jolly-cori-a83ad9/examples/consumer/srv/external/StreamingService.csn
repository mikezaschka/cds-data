{
  "definitions": {
    "StreamingService": {
      "kind": "service"
    },
    "StreamingService.Regions": {
      "kind": "entity",
      "@readonly": true,
      "projection": {
        "from": {
          "ref": [
            "streaming.Regions"
          ]
        }
      },
      "elements": {
        "code": {
          "key": true,
          "type": "cds.String",
          "length": 10
        },
        "name": {
          "type": "cds.String",
          "length": 50
        },
        "continent": {
          "type": "cds.String",
          "length": 20
        }
      }
    },
    "StreamingService.StreamingManifests": {
      "kind": "entity",
      "@readonly": true,
      "projection": {
        "from": {
          "ref": [
            "streaming.StreamingManifests"
          ]
        }
      },
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.String",
          "length": 20
        },
        "movie_ID": {
          "type": "cds.String",
          "length": 10
        },
        "region": {
          "type": "cds.Association",
          "target": "StreamingService.Regions",
          "keys": [
            {
              "ref": [
                "code"
              ]
            }
          ]
        },
        "bitrate": {
          "type": "cds.Integer"
        },
        "drmScheme": {
          "type": "cds.String",
          "length": 20
        },
        "maxResolution": {
          "type": "cds.String",
          "length": 10
        },
        "availableFrom": {
          "type": "cds.Date"
        },
        "availableUntil": {
          "type": "cds.Date"
        },
        "manifestUrl": {
          "type": "cds.String",
          "length": 500
        }
      }
    },
    "streaming.Regions": {
      "kind": "entity",
      "elements": {
        "code": {
          "key": true,
          "type": "cds.String",
          "length": 10
        },
        "name": {
          "type": "cds.String",
          "length": 50
        },
        "continent": {
          "type": "cds.String",
          "length": 20
        }
      }
    },
    "streaming.StreamingManifests": {
      "kind": "entity",
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.String",
          "length": 20
        },
        "movie_ID": {
          "type": "cds.String",
          "length": 10
        },
        "region": {
          "type": "cds.Association",
          "target": "streaming.Regions",
          "keys": [
            {
              "ref": [
                "code"
              ]
            }
          ]
        },
        "bitrate": {
          "type": "cds.Integer"
        },
        "drmScheme": {
          "type": "cds.String",
          "length": 20
        },
        "maxResolution": {
          "type": "cds.String",
          "length": 10
        },
        "availableFrom": {
          "type": "cds.Date"
        },
        "availableUntil": {
          "type": "cds.Date"
        },
        "manifestUrl": {
          "type": "cds.String",
          "length": 500
        }
      }
    }
  }
}
