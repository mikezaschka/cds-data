{
  "definitions": {
    "LicensingService": {
      "kind": "service"
    },
    "LicensingService.Titles": {
      "kind": "entity",
      "projection": {
        "from": {
          "ref": [
            "licensing.Titles"
          ]
        }
      },
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.String",
          "length": 10
        },
        "titleName": {
          "type": "cds.String",
          "length": 200
        },
        "movieRef": {
          "type": "cds.String",
          "length": 10
        },
        "licensor": {
          "type": "cds.String",
          "length": 50
        },
        "territory": {
          "type": "cds.String",
          "length": 3
        },
        "licenseStart": {
          "type": "cds.Date"
        },
        "licenseEnd": {
          "type": "cds.Date"
        },
        "exclusive": {
          "type": "cds.Boolean",
          "default": {
            "val": false
          }
        }
      }
    },
    "LicensingService.TerritoryLicenses": {
      "kind": "entity",
      "projection": {
        "from": {
          "ref": [
            "licensing.TerritoryLicenses"
          ]
        }
      },
      "elements": {
        "title": {
          "key": true,
          "type": "cds.Association",
          "target": "LicensingService.Titles",
          "keys": [
            {
              "ref": [
                "ID"
              ]
            }
          ]
        },
        "territory": {
          "key": true,
          "type": "cds.String",
          "length": 3
        },
        "rights": {
          "type": "cds.String",
          "length": 50
        }
      }
    },
    "licensing.Titles": {
      "kind": "entity",
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.String",
          "length": 10
        },
        "titleName": {
          "type": "cds.String",
          "length": 200
        },
        "movieRef": {
          "type": "cds.String",
          "length": 10
        },
        "licensor": {
          "type": "cds.String",
          "length": 50
        },
        "territory": {
          "type": "cds.String",
          "length": 3
        },
        "licenseStart": {
          "type": "cds.Date"
        },
        "licenseEnd": {
          "type": "cds.Date"
        },
        "exclusive": {
          "type": "cds.Boolean",
          "default": {
            "val": false
          }
        }
      }
    },
    "licensing.TerritoryLicenses": {
      "kind": "entity",
      "elements": {
        "title": {
          "key": true,
          "type": "cds.Association",
          "target": "licensing.Titles",
          "keys": [
            {
              "ref": [
                "ID"
              ]
            }
          ]
        },
        "territory": {
          "key": true,
          "type": "cds.String",
          "length": 3
        },
        "rights": {
          "type": "cds.String",
          "length": 50
        }
      }
    }
  }
}
