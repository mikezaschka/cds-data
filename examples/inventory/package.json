{
  "name": "examples-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Example OData V4 inventory provider on port 4445.",
  "scripts": {
    "start": "cds-serve --port 4445",
    "watch": "cds watch --port 4445"
  },
  "dependencies": {
    "@sap/cds": ">=9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }
}
